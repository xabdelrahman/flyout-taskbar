<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Frosted Minimal. The window backdrop supplies the blur; these brushes supply the
        frosted surface, the rim that catches light along the top edge, and the sheen.

        The scrim is deliberately substantial: acrylic alone takes its luminosity from
        whatever sits behind the window, so a light panel over a dark background turns
        grey under near-black text. Anchoring it to the theme keeps the panel readable
        over anything while still reading as glass.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlassScrimBrush" Color="#85FFFFFF" />

            <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Offset="0.0" Color="#4DFFFFFF" />
                <GradientStop Offset="0.45" Color="#0FFFFFFF" />
                <GradientStop Offset="1.0" Color="#00FFFFFF" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#C4FFFFFF" />
                <GradientStop Offset="0.55" Color="#7AFFFFFF" />
                <GradientStop Offset="1.0" Color="#1F000000" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="GlassButtonFillBrush" Color="#75FFFFFF" />
            <SolidColorBrush x:Key="GlassButtonBorderBrush" Color="#1A161C28" />
            <SolidColorBrush x:Key="GlassPrimaryFillBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="GlassPrimaryBorderBrush" Color="#B8FFFFFF" />

            <SolidColorBrush x:Key="GlassArtworkFillBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="GlassArtworkBorderBrush" Color="#8CFFFFFF" />

            <SolidColorBrush x:Key="SeekTrackBrush" Color="#29161C28" />
            <SolidColorBrush x:Key="SeekFillBrush" Color="#9E161C28" />
            <SolidColorBrush x:Key="SeekThumbBrush" Color="#FFFFFFFF" />

            <!-- Matches the Windows 11 taskbar so the bar reads as part of it. -->
            <SolidColorBrush x:Key="TaskbarFillBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="TaskbarHoverBrush" Color="#14000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GlassScrimBrush" Color="#8C12141A" />

            <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Offset="0.0" Color="#24FFFFFF" />
                <GradientStop Offset="0.45" Color="#0AFFFFFF" />
                <GradientStop Offset="1.0" Color="#00FFFFFF" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#6BFFFFFF" />
                <GradientStop Offset="0.55" Color="#26FFFFFF" />
                <GradientStop Offset="1.0" Color="#14FFFFFF" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="GlassButtonFillBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="GlassButtonBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="GlassPrimaryFillBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="GlassPrimaryBorderBrush" Color="#4DFFFFFF" />

            <SolidColorBrush x:Key="GlassArtworkFillBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="GlassArtworkBorderBrush" Color="#2EFFFFFF" />

            <SolidColorBrush x:Key="SeekTrackBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SeekFillBrush" Color="#C4FFFFFF" />
            <SolidColorBrush x:Key="SeekThumbBrush" Color="#FFFFFFFF" />

            <!-- Matches the Windows 11 taskbar so the bar reads as part of it. -->
            <SolidColorBrush x:Key="TaskbarFillBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="TaskbarHoverBrush" Color="#1FFFFFFF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Transport buttons: translucent discs that sit on the frosted surface. -->
    <Style x:Key="GlassButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GlassButtonFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryGlassButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource GlassPrimaryFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassPrimaryBorderBrush}" />
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
    </Style>

    <!-- Flat, taskbar-sized transport buttons: no disc, just a hover fill. -->
    <Style x:Key="BarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        A hairline seek bar. The stock Slider is far too heavy for this panel, so this
        retemplates it down to a 3px track with a small round thumb, while keeping the
        real Slider so keyboard seeking and screen readers still work.
    -->
    <Style x:Key="SeekBarStyle" TargetType="Slider">
        <Setter Property="Background" Value="{ThemeResource SeekTrackBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SeekFillBrush}" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
        <Setter Property="ManipulationMode" Value="None" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderContainer" Background="Transparent">
                        <Grid x:Name="HorizontalTemplate" MinHeight="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Rectangle
                                x:Name="HorizontalTrackRect"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Height="3"
                                RadiusX="1.5"
                                RadiusY="1.5"
                                Fill="{TemplateBinding Background}" />

                            <Rectangle
                                x:Name="HorizontalDecreaseRect"
                                Grid.Row="1"
                                Height="3"
                                RadiusX="1.5"
                                RadiusY="1.5"
                                Fill="{TemplateBinding Foreground}" />

                            <Thumb
                                x:Name="HorizontalThumb"
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                Width="11"
                                Height="11"
                                AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse
                                            Width="11"
                                            Height="11"
                                            Fill="{ThemeResource SeekThumbBrush}"
                                            Stroke="{ThemeResource GlassButtonBorderBrush}"
                                            StrokeThickness="0.5" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
