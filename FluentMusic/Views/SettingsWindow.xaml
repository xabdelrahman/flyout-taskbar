<Window
    x:Class="FluentMusic.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid RowDefinitions="Auto,*">

        <Grid x:Name="TitleBarArea" Height="36" Padding="14,0">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Fluent Music" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="22,4,22,22">
            <StackPanel Spacing="18">

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Settings" />

                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Where the player lives" />

                    <RadioButton
                        x:Name="EdgeModeOption"
                        GroupName="PlayerMode"
                        Checked="OnModeChecked"
                        Tag="EdgeHandle">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Edge tab" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="A small handle tucked against the side of the screen. Drag it to move, click to open the player." />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="TaskbarModeOption"
                        GroupName="PlayerMode"
                        Checked="OnModeChecked"
                        Tag="TaskbarBar">
                        <StackPanel Spacing="1">
                            <TextBlock Text="In the taskbar" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="A bar inside the taskbar strip, left of the clock, with artwork, controls and a playing waveform." />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Taskbar bar" />

                    <ToggleSwitch
                        x:Name="WaveformToggle"
                        Header="Animate the waveform while playing"
                        OnContent="On"
                        OffContent="Off"
                        Toggled="OnWaveformToggled" />
                </StackPanel>

                <TextBlock
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="The taskbar bar is drawn over the taskbar's empty area rather than inserted into it. Windows 11 has no supported way to add content to the taskbar itself, and the alternative would mean modifying Explorer." />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
