<UserControl
    x:Class="FluentMusic.Views.TaskbarBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentMusic.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <MenuFlyout x:Key="SurfaceMenu">
            <MenuFlyoutItem Text="Settings" Click="OnSettingsClick" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Exit" Click="OnExitClick" />
        </MenuFlyout>
    </UserControl.Resources>

        <Border
            x:Name="Surface"
            CornerRadius="6"
            Background="{ThemeResource TaskbarFillBrush}"
            ContextFlyout="{StaticResource SurfaceMenu}"
            PointerPressed="OnSurfacePointerPressed"
            PointerMoved="OnSurfacePointerMoved"
            PointerReleased="OnSurfacePointerReleased">

            <Grid CornerRadius="6">
                <Grid Padding="10,0,12,0" ColumnSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Artwork -->
                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        CornerRadius="5"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource GlassArtworkBorderBrush}"
                        Background="{ThemeResource GlassArtworkFillBrush}">
                        <Grid>
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="&#xE8D6;"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind ViewModel.NoArtwork, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Border
                                CornerRadius="5"
                                Visibility="{x:Bind ViewModel.HasArtwork, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind ViewModel.Artwork, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Track -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0" MinWidth="0">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Text="{x:Bind ViewModel.Artist, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Transport -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                        <Button
                            Style="{StaticResource BarButtonStyle}"
                            Command="{x:Bind ViewModel.PreviousCommand}"
                            ToolTipService.ToolTip="Previous"
                            AutomationProperties.Name="Previous track">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE892;" FontSize="13" />
                        </Button>
                        <Button
                            Style="{StaticResource BarButtonStyle}"
                            Command="{x:Bind ViewModel.PlayPauseCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseTooltip, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.PlayPauseTooltip, Mode=OneWay}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                FontSize="14" />
                        </Button>
                        <Button
                            Style="{StaticResource BarButtonStyle}"
                            Command="{x:Bind ViewModel.NextCommand}"
                            ToolTipService.ToolTip="Next"
                            AutomationProperties.Name="Next track">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE893;" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <!-- Waveform: bars are built in code so the count stays one constant.
                         Decorative only, so it is hidden from assistive technology. -->
                    <StackPanel
                        x:Name="Waveform"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="3"
                        Height="22"
                        AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Grid>
        </Border>
    </UserControl>
